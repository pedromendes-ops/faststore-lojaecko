{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "PromoDay",
  "$componentTitle": "Ofertas do dia",
  "title": "Ofertas do dia",
  "description": "Drawer lateral com ofertas promocionais.",
  "type": "object",
  "properties": {
    "active": {
      "title": "Ativar seção?",
      "type": "boolean",
      "default": true
    },
    "activeButton": {
      "title": "Exibir botão de abertura?",
      "description": "Exibe ou oculta o botão que abre o drawer de ofertas.",
      "type": "boolean",
      "default": true
    },
    "cards": {
      "title": "Ofertas",
      "description": "Cadastre os cards exibidos no drawer lateral.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "title": "Oferta",
        "type": "object",
        "properties": {
          "active": {
            "title": "Ativar oferta?",
            "type": "boolean",
            "default": true
          },
          "showBanner": {
            "title": "Exibir banner?",
            "type": "boolean",
            "default": true
          },
          "fileBanner": {
            "title": "Imagem desktop",
            "type": "string",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": [
                  "png",
                  "jpg",
                  "jpeg",
                  "gif",
                  "svg",
                  "webp"
                ]
              }
            }
          },
          "fileBannerPhone": {
            "title": "Imagem mobile",
            "description": "Opcional. Se não for cadastrada, utiliza a imagem desktop.",
            "type": "string",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": [
                  "png",
                  "jpg",
                  "jpeg",
                  "gif",
                  "svg",
                  "webp"
                ]
              }
            }
          },
          "altBanner": {
            "title": "Texto alternativo da imagem",
            "description": "Descrição da imagem para acessibilidade.",
            "type": "string"
          },
          "linkBanner": {
            "title": "Link do banner",
            "description": "Opcional. URL acessada ao clicar no banner.",
            "type": "string"
          },
          "targetLinkBanner": {
            "title": "Onde abrir o link do banner?",
            "type": "string",
            "enum": [
              "_self",
              "_blank"
            ],
            "enumNames": [
              "Mesma aba",
              "Nova aba"
            ],
            "default": "_self"
          },
          "text": {
            "title": "Conteúdo",
            "description": "Texto exibido abaixo da imagem.",
            "type": "string",
            "widget": {
              "ui:widget": "rich-text"
            }
          },
          "links": {
            "title": "Links",
            "description": "Adicione até 3 links por oferta.",
            "type": "array",
            "maxItems": 3,
            "items": {
              "title": "Link",
              "type": "object",
              "properties": {
                "linkText": {
                  "title": "Texto do link",
                  "type": "string"
                },
                "urlLinkText": {
                  "title": "URL",
                  "type": "string"
                },
                "targetLinkText": {
                  "title": "Onde abrir?",
                  "type": "string",
                  "enum": [
                    "_self",
                    "_blank"
                  ],
                  "enumNames": [
                    "Mesma aba",
                    "Nova aba"
                  ],
                  "default": "_self"
                }
              }
            }
          },
          "showPolicy": {
            "title": "Exibir política ou regulamento?",
            "type": "boolean",
            "default": false
          },
          "policyText": {
            "title": "Texto da política",
            "description": "Ex.: Consulte as condições da promoção.",
            "type": "string"
          },
          "policyLink": {
            "title": "Link da política",
            "description": "Opcional. Se informado, o texto da política será exibido como link.",
            "type": "string"
          }
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}