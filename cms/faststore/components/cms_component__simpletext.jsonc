{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "Simpletext",
  "$componentTitle": "Simple Text",
  "title": "Simple Text",
  "description": "Demo Simple Text",
  "type": "object",
  "properties": {
    "className": {
      "title": "Classe CSS",
      "type": "string",
      "description": "Nome da classe CSS para estilização"
    },
    "maxWidthSection": {
      "title": "Largura máxima",
      "type": "string",
      "description": "Somente números, sem px ou %"
    },
    "marginTopSection": {
      "title": "Margem superior",
      "type": "string",
      "default": "0",
      "description": "Somente números, sem px ou %"
    },
    "areaSection": {
      "title": "Área da sessão",
      "type": "string",
      "enum": [
        "container",
        "full"
      ],
      "enumNames": [
        "container",
        "full"
      ],
      "default": "container"
    },
    "sectionLabel": {
      "title": "Descrição acessível da sessão",
      "type": "string"
    },
    "showTitle": {
      "title": "Exibir o título?",
      "type": "boolean"
    },
    "titleText": {
      "title": "Título",
      "type": "string"
    },
    "tagTitle": {
      "title": "Marcação do Título",
      "enum": [
        "h1",
        "h2",
        "h3"
      ],
      "enumNames": [
        "Título 1",
        "Título 2",
        "Título 3"
      ],
      "default": "h1"
    },
    "alignTitle": {
      "title": "Alinhamento do Título",
      "enum": [
        "center",
        "left"
      ],
      "enumNames": [
        "Centralizado",
        "À esquerda"
      ],
      "default": "center"
    },
    "storesText": {
      "title": "Texto Lojas",
      "type": "string",
      "widget": {
        "ui:widget": "draftjs-rich-text"
      }
    },
    "active": {
      "title": "Ativo",
      "type": "boolean"
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}