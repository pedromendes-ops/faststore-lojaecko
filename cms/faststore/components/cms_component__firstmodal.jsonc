{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "FirstModal",
  "$componentTitle": "First Modal",
  "title": "First Modal",
  "description": "Modal inicial com imagem, texto e formulário dinâmico",
  "type": "object",
  "properties": {
    "active": {
      "title": "Ativar modal",
      "type": "boolean",
      "default": true
    },
    "storageKey": {
      "title": "Chave do storage",
      "type": "string",
      "default": "first-modal-closed"
    },
    "storageType": {
      "title": "Tipo de armazenamento",
      "type": "string",
      "enum": [
        "localStorage",
        "sessionStorage"
      ],
      "enumNames": [
        "LocalStorage",
        "SessionStorage"
      ],
      "default": "localStorage"
    },
    "delaySeconds": {
      "title": "Tempo para abrir o modal",
      "type": "string",
      "default": "0",
      "description": "Tempo em segundos"
    },
    "maxWidthModal": {
      "title": "Largura máxima do modal",
      "type": "string",
      "default": "960"
    },
    "heightModal": {
      "title": "Altura mínima do modal",
      "type": "string",
      "default": "540"
    },
    "image": {
      "title": "Imagem desktop",
      "type": "string",
      "widget": {
        "ui:widget": "media-gallery",
        "restrictMediaTypes": {
          "video": true,
          "image": [
            "png",
            "jpg",
            "jpeg",
            "gif",
            "svg",
            "webp"
          ]
        }
      }
    },
    "imageMobile": {
      "title": "Imagem mobile",
      "type": "string",
      "widget": {
        "ui:widget": "media-gallery",
        "restrictMediaTypes": {
          "video": true,
          "image": [
            "png",
            "jpg",
            "jpeg",
            "gif",
            "svg",
            "webp"
          ]
        }
      }
    },
    "imageAlt": {
      "title": "Texto alternativo da imagem",
      "type": "string"
    },
    "title": {
      "title": "Título",
      "type": "string",
      "default": "Modal"
    },
    "text": {
      "title": "Texto",
      "type": "string"
    },
    "backgroundText": {
      "title": "Cor de fundo do texto",
      "type": "string",
      "default": "#ffffff"
    },
    "colorText": {
      "title": "Cor do texto",
      "type": "string",
      "default": "#110b0d"
    },
    "closeLabel": {
      "title": "Texto acessível do fechar",
      "type": "string",
      "default": "Fechar modal"
    },
    "showForm": {
      "title": "Exibir formulário",
      "type": "boolean",
      "default": false
    },
    "successMessage": {
      "title": "Mensagem de sucesso",
      "type": "string",
      "default": "Enviado com sucesso!"
    },
    "formFields": {
      "type": "array",
      "title": "Campos do formulário",
      "items": {
        "type": "object",
        "title": "Campo",
        "properties": {
          "type": {
            "title": "Tipo do campo",
            "type": "string",
            "enum": [
              "text",
              "email",
              "tel",
              "checkbox",
              "radio",
              "select",
              "submit"
            ],
            "enumNames": [
              "Texto",
              "E-mail",
              "Telefone",
              "Checkbox",
              "Radio",
              "Select",
              "Button"
            ],
            "default": "text"
          },
          "name": {
            "title": "Nome técnico do campo",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "placeholder": {
            "title": "Placeholder",
            "type": "string"
          },
          "required": {
            "title": "Obrigatório",
            "type": "boolean",
            "default": false
          },
          "options": {
            "type": "array",
            "title": "Opções",
            "items": {
              "type": "object",
              "title": "Opção",
              "properties": {
                "label": {
                  "title": "Texto",
                  "type": "string"
                },
                "value": {
                  "title": "Valor",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}