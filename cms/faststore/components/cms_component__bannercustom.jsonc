{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "BannerCustom",
  "$componentTitle": "Banner Custom",
  "title": "Banner Custom",
  "description": "Banner com imagem única ou banner duplo (duas imagens lado a lado), com imagem separada para mobile.",
  "type": "object",
  "required": [
    "banners",
    "height"
  ],
  "properties": {
    "isDoubleBanner": {
      "title": "Banner duplo?",
      "description": "Quando ativado, exibe duas imagens lado a lado",
      "type": "boolean",
      "default": false
    },
    "display": {
      "title": "Exibição",
      "description": "Tela cheia (full) ou dentro do container do site",
      "type": "string",
      "enum": [
        "full",
        "container"
      ],
      "enumNames": [
        "Tela cheia",
        "Container"
      ],
      "default": "full"
    },
    "height": {
      "title": "Altura (px)",
      "type": "number",
      "minimum": 50,
      "default": 700
    },
    "loading": {
      "title": "Carregamento",
      "type": "string",
      "enum": [
        "eager",
        "lazy"
      ],
      "enumNames": [
        "Eager",
        "Lazy"
      ],
      "default": "lazy"
    },
    "maxWidthSection": {
      "title": "Largura máxima",
      "type": "string",
      "description": "Somente números, sem px ou %"
    },
    "marginTopSection": {
      "title": "Margem superior",
      "type": "string",
      "default": "0",
      "description": "Somente números, sem px ou %"
    },
    "marginTopSectionPhone": {
      "title": "Margem superior no mobile",
      "type": "string",
      "default": "0",
      "description": "Somente números, sem px ou %"
    },
    "sectionLabel": {
      "title": "Descrição acessível da sessão",
      "type": "string"
    },
    "banners": {
      "title": "Banners",
      "description": "Se 'Banner duplo' estiver desativado, apenas o primeiro banner é exibido",
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "title": "Banner",
        "type": "object",
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "title": "Imagem Desktop",
            "type": "string",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": [
                  "png",
                  "jpg",
                  "jpeg",
                  "gif",
                  "svg",
                  "webp"
                ]
              }
            }
          },
          "useSameImageMobile": {
            "title": "Usar mesma imagem no mobile?",
            "description": "Ative para não precisar subir uma imagem específica para mobile",
            "type": "boolean",
            "default": true
          },
          "imageMobile": {
            "title": "Imagem Mobile",
            "description": "Usada apenas quando 'Usar mesma imagem no mobile' estiver desativado",
            "type": "string",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": [
                  "png",
                  "jpg",
                  "jpeg",
                  "gif",
                  "svg",
                  "webp"
                ]
              }
            }
          },
          "href": {
            "title": "Link",
            "type": "string",
            "default": "#"
          },
          "target": {
            "title": "Abrir link",
            "type": "string",
            "enum": [
              "_self",
              "_blank"
            ],
            "enumNames": [
              "Mesma aba",
              "Nova aba"
            ],
            "default": "_self"
          }
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}