{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "SimpleBanner",
  "$componentTitle": "Simple Banner",
  "title": "Simple Banner",
  "description": "A simple banner.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "title": "Banner Item",
      "description": "List images of banner",
      "items": {
        "type": "object",
        "title": "Banner info",
        "properties": {
          "image": {
            "type": "string",
            "title": "Image",
            "description": "URL or path to the banner image for desktop",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": [
                  "png",
                  "jpg",
                  "jpeg",
                  "gif",
                  "svg",
                  "webp"
                ]
              }
            }
          },
          "imageMobile": {
            "type": "string",
            "title": "Mobile Image",
            "description": "URL or path to the banner image for mobile devices",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": [
                  "png",
                  "jpg",
                  "jpeg",
                  "gif",
                  "svg",
                  "webp"
                ]
              }
            }
          },
          "href": {
            "type": "string",
            "title": "Link URL",
            "description": "URL where the banner should redirect when clicked (optional)"
          },
          "target": {
            "type": "string",
            "title": "Link Target",
            "description": "How the link should open",
            "enum": [
              "_blank",
              "_self"
            ],
            "enumNames": [
              "New Tab",
              "Same Tab"
            ],
            "default": "_self"
          },
          "hastext": {
            "type": "boolean",
            "title": "Show Text",
            "default": true
          },
          "aligntextvertical": {
            "type": "string",
            "title": "Align Text Vertical",
            "description": "Alinamento do texto horizontal",
            "enum": [
              "top",
              "center",
              "bottom"
            ],
            "enumNames": [
              "top",
              "center",
              "bottom"
            ],
            "default": "center"
          },
          "aligntexthorizontal": {
            "type": "string",
            "title": "Align Text Hotizontal",
            "description": "Alinamento do texto na horizontal",
            "enum": [
              "left",
              "center",
              "right"
            ],
            "enumNames": [
              "left",
              "center",
              "right"
            ],
            "default": "center"
          },
          "textbanner": {
            "type": "string",
            "title": "Text of banner",
            "description": "Texto livre em html",
            "default": ""
          },
          "textcolor": {
            "type": "string",
            "title": "Color of text",
            "description": "Cor hexadecimal do banner",
            "default": ""
          }
        }
      },
      "minItems": 1
    },
    "height": {
      "type": "number",
      "title": "Height Image",
      "description": "Algura da imagem em pixel",
      "minimum": 100,
      "default": 700
    },
    "loading": {
      "type": "string",
      "title": "Loading Banner",
      "description": "Tipo do carregamento",
      "enum": [
        "eager",
        "lazy"
      ],
      "enumNames": [
        "Eager",
        "Lazy"
      ],
      "default": "lazy"
    },
    "columnDesktop": {
      "type": "number",
      "title": "Colunas no desktop",
      "description": "Quantidade de colunas no desktop",
      "default": 1
    },
    "columnMobile": {
      "type": "number",
      "title": "Colunas para o mobile",
      "description": "Quantidade de colunas no mobile",
      "default": 1
    },
    "paddingbanner": {
      "type": "number",
      "title": "Padding banner",
      "description": "Espaçamento entro as colunas em pixel",
      "default": 1
    },
    "bannerposition": {
      "type": "string",
      "title": "Position Banner",
      "description": "Enquadramento do banner",
      "enum": [
        "container",
        "full"
      ],
      "enumNames": [
        "container",
        "full"
      ],
      "default": "full"
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}