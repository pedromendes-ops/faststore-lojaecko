{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "CollectionGalleryCustom",
  "$componentTitle": "Collection Gallery Custom",
  "title": "Collection Gallery Custom",
  "description": "Renders a VTEX collection as a full PLP-style gallery (grid, filters, sort and pagination) on any page.",
  "type": "object",
  "required": [
    "collectionId",
    "filter"
  ],
  "properties": {
    "collectionId": {
      "title": "Collection ID",
      "description": "VTEX collection (product cluster) id. E.g. for the 'Most Wanted' collection, use: 140. Find your collection ids under Catalog > Collections in the Admin.",
      "type": "string",
      "default": "140"
    },
    "title": {
      "title": "Title",
      "type": "string",
      "default": ""
    },
    "totalCountLabel": {
      "title": "Total count label",
      "type": "string",
      "default": "Results"
    },
    "itemsPerPage": {
      "title": "Items per page",
      "description": "Number of products fetched per page.",
      "type": "integer",
      "default": 12
    },
    "itemsPerRow": {
      "title": "Items per row",
      "description": "Number of product cards displayed per row in the gallery grid",
      "type": "integer",
      "enum": [
        2,
        3
      ],
      "enumNames": [
        "2 items",
        "3 items"
      ],
      "default": 2
    },
    "showUnavailableProducts": {
      "title": "Show unavailable products?",
      "description": "When enabled, out-of-stock products are also shown. Otherwise only available products appear (store default).",
      "type": "boolean",
      "default": false
    },
    "stateFilter": {
      "title": "Filtro fechado no desktop?",
      "type": "boolean",
      "default": false
    },
    "contentCards": {
      "title": "Cards entre produtos",
      "description": "Adiciona banners e/ou blocos de texto entre os produtos da primeira página da galeria.",
      "type": "array",
      "items": {
        "title": "Card editorial",
        "type": "object",
        "required": [
          "position"
        ],
        "properties": {
          "active": {
            "title": "Ativo?",
            "type": "boolean",
            "default": true
          },
          "position": {
            "title": "Posição no grid",
            "description": "Posição que o card ocupará no grid. Ex.: 4 coloca o card depois dos três primeiros elementos.",
            "type": "integer",
            "minimum": 1,
            "default": 4
          },
          "images": {
            "title": "Imagens",
            "description": "Cadastre uma ou mais imagens. Com mais de uma imagem, o card será exibido como carrossel.",
            "type": "array",
            "items": {
              "title": "Imagem",
              "type": "object",
              "properties": {
                "image": {
                  "title": "Imagem desktop",
                  "type": "string",
                  "widget": {
                    "ui:widget": "media-gallery",
                    "restrictMediaTypes": {
                      "video": true,
                      "image": [
                        "png",
                        "jpg",
                        "jpeg",
                        "gif",
                        "svg",
                        "webp"
                      ]
                    }
                  }
                },
                "imageMobile": {
                  "title": "Imagem mobile",
                  "description": "Opcional. Se não for cadastrada, utiliza a imagem desktop.",
                  "type": "string",
                  "widget": {
                    "ui:widget": "media-gallery",
                    "restrictMediaTypes": {
                      "video": true,
                      "image": [
                        "png",
                        "jpg",
                        "jpeg",
                        "gif",
                        "svg",
                        "webp"
                      ]
                    }
                  }
                },
                "imageAlt": {
                  "title": "Texto alternativo da imagem",
                  "description": "Descrição da imagem para acessibilidade.",
                  "type": "string",
                  "default": ""
                },
                "link": {
                  "title": "Link",
                  "type": "string",
                  "default": ""
                },
                "linkLabel": {
                  "title": "Texto do link",
                  "type": "string",
                  "default": ""
                },
                "target": {
                  "title": "Abrir link em",
                  "type": "string",
                  "enum": [
                    "_self",
                    "_blank"
                  ],
                  "enumNames": [
                    "Mesma página",
                    "Nova aba"
                  ],
                  "default": "_self"
                }
              }
            }
          },
          "title": {
            "title": "Título",
            "type": "string",
            "default": ""
          },
          "text": {
            "title": "Texto",
            "type": "string",
            "default": ""
          },
          "columnsDesktop": {
            "title": "Colunas no desktop",
            "description": "Quantidade de colunas do grid ocupadas pelo card.",
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "enumNames": [
              "1 coluna",
              "2 colunas",
              "3 colunas"
            ],
            "default": 1
          },
          "columnsTablet": {
            "title": "Colunas no tablet",
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "enumNames": [
              "1 coluna",
              "2 colunas",
              "3 colunas"
            ],
            "default": 1
          },
          "columnsMobile": {
            "title": "Colunas no mobile",
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "enumNames": [
              "1 coluna",
              "2 colunas"
            ],
            "default": 2
          },
          "textPosition": {
            "title": "Posição do texto",
            "type": "string",
            "enum": [
              "below",
              "overlay-bottom",
              "overlay-center"
            ],
            "enumNames": [
              "Abaixo da imagem",
              "Sobre a imagem - inferior",
              "Sobre a imagem - centralizado"
            ],
            "default": "below"
          },
          "textAlign": {
            "title": "Alinhamento do texto",
            "type": "string",
            "enum": [
              "left",
              "center",
              "right"
            ],
            "enumNames": [
              "Esquerda",
              "Centralizado",
              "Direita"
            ],
            "default": "left"
          }
        }
      }
    },
    "filter": {
      "title": "Filter",
      "type": "object",
      "required": [
        "title",
        "mobileOnly"
      ],
      "properties": {
        "title": {
          "title": "Filter title",
          "type": "string",
          "default": "Filters"
        },
        "ordering": {
          "title": "Filters ordering",
          "type": "object",
          "description": "Controls the order of the filter groups and of the values inside each group.",
          "properties": {
            "groups": {
              "title": "Order of filter groups",
              "type": "string",
              "enum": [
                "default",
                "asc",
                "desc"
              ],
              "enumNames": [
                "Original (from search)",
                "Alphabetical A-Z",
                "Alphabetical Z-A"
              ],
              "default": "default"
            },
            "values": {
              "title": "Order of values inside each filter",
              "type": "string",
              "enum": [
                "default",
                "asc",
                "desc"
              ],
              "enumNames": [
                "Original (from search)",
                "Alphabetical A-Z",
                "Alphabetical Z-A"
              ],
              "default": "default"
            },
            "lastKeys": {
              "title": "Filters always shown last",
              "description": "Filtros sempre exibidos por último (separados por vírgula). Digite a label — ex.: Preço. Ignora maiúsculas/acentos; a chave do facet também funciona.",
              "type": "string",
              "default": "price"
            },
            "pinned": {
              "title": "Posições fixas de filtros",
              "description": "Fixa filtros específicos em posições exatas (1 = primeiro, 2 = segundo…). Os demais filtros preenchem os espaços restantes na ordem definida acima. Sobrepõe 'sempre por último' para os filtros listados.",
              "type": "array",
              "items": {
                "type": "object",
                "title": "Filtro fixo",
                "required": [
                  "label",
                  "position"
                ],
                "properties": {
                  "label": {
                    "title": "Nome do filtro (label)",
                    "description": "Digite a label do filtro exatamente como aparece na loja (ex.: Departamento, Preço, Cor, Tamanhos). Ignora maiúsculas e acentos; a chave do facet também funciona.",
                    "type": "string"
                  },
                  "position": {
                    "title": "Posição (1 = primeiro)",
                    "type": "integer",
                    "default": 1,
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "hiddenFilter": {
          "title": "Filtros ocultos",
          "description": "Filtros que não devem aparecer na lista. Digite a label do filtro exatamente como aparece na loja (ex.: Fit, productClusterNames). Ignora maiúsculas e acentos; a chave do facet também funciona.",
          "type": "array",
          "items": {
            "type": "object",
            "title": "Filtro oculto",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "title": "Nome do filtro (label)",
                "description": "Label do filtro a esconder (ex.: Fit).",
                "type": "string"
              }
            }
          }
        },
        "mobileOnly": {
          "title": "Mobile Only",
          "type": "object",
          "required": [
            "filterButton",
            "clearButtonLabel",
            "applyButtonLabel"
          ],
          "properties": {
            "filterButton": {
              "title": "Show filter button",
              "type": "object",
              "required": [
                "label",
                "icon"
              ],
              "properties": {
                "label": {
                  "title": "Label",
                  "type": "string",
                  "default": "Filters"
                },
                "icon": {
                  "title": "Icon",
                  "type": "object",
                  "required": [
                    "icon",
                    "alt"
                  ],
                  "properties": {
                    "icon": {
                      "title": "Icon",
                      "type": "string",
                      "enumNames": [
                        "FadersHorizontal"
                      ],
                      "enum": [
                        "FadersHorizontal"
                      ],
                      "default": "FadersHorizontal"
                    },
                    "alt": {
                      "title": "Alternative label",
                      "type": "string",
                      "default": "Open Filters"
                    }
                  }
                }
              }
            },
            "clearButtonLabel": {
              "title": "Clear button label",
              "type": "string",
              "default": "Clear All"
            },
            "applyButtonLabel": {
              "title": "Apply button label",
              "type": "string",
              "default": "Apply"
            }
          }
        }
      }
    },
    "productCard": {
      "title": "Product Card Configuration",
      "type": "object",
      "properties": {
        "showDiscountBadge": {
          "title": "Show discount badge?",
          "type": "boolean",
          "default": true
        },
        "bordered": {
          "title": "Cards should be bordered?",
          "type": "boolean",
          "default": true
        },
        "taxesConfiguration": {
          "title": "Taxes Configuration",
          "type": "object",
          "properties": {
            "usePriceWithTaxes": {
              "title": "Should use taxes to calculate the price?",
              "type": "boolean",
              "default": false
            },
            "taxesLabel": {
              "title": "Tax label to be displayed",
              "type": "string",
              "default": "Tax included"
            }
          }
        },
        "sponsoredLabel": {
          "title": "Sponsored Label",
          "type": "string",
          "default": "Sponsored"
        },
        "showProductClusters": {
          "title": "Show product cluster tags?",
          "type": "boolean",
          "default": true,
          "description": "Tags exibidas sobre a imagem do produto (ex.: Lançamento, Exclusivo). Quais tags aparecem é cadastro único em Global Sections → CollectionTag, uma seção por coleção."
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}