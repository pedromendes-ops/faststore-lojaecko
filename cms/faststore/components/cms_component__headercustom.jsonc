{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "HeaderCustom",
  "$componentTitle": "Header Custom",
  "title": "Header Custom",
  "description": "Topo global das páginas.",
  "type": "object",
  "required": [
    "imageSrc"
  ],
  "properties": {
    "legend": {
      "type": "string",
      "title": "Nome da loja",
      "default": "Loja"
    },
    "imageSrc": {
      "type": "string",
      "title": "Logo",
      "widget": {
        "ui:widget": "media-gallery",
        "restrictMediaTypes": {
          "video": true,
          "image": [
            "png",
            "jpg",
            "jpeg",
            "gif",
            "svg",
            "webp"
          ]
        }
      }
    },
    "topBar": {
      "title": "TopBar",
      "type": "object",
      "properties": {
        "background": {
          "title": "Cor de fundo",
          "type": "string",
          "default": "#000000",
          "description": "Hexadecimal"
        },
        "items": {
          "title": "Textos do TopBar",
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "Texto",
            "type": "object",
            "properties": {
              "text": {
                "title": "Texto",
                "type": "string"
              }
            },
            "required": [
              "text"
            ]
          }
        }
      }
    },
    "search": {
      "title": "Busca",
      "type": "object",
      "properties": {
        "searchButtonDesktop": {
          "title": "Usar botão no desktop?",
          "type": "boolean",
          "default": false
        },
        "searchButtonMobile": {
          "title": "Usar botão no mobile?",
          "type": "boolean",
          "default": true
        },
        "placeholder": {
          "title": "Placeholder",
          "type": "string",
          "default": "Encontre um produto..."
        }
      }
    },
    "welcome": {
      "title": "Minha conta",
      "description": "Configurações da área de identificação do cliente.",
      "type": "object",
      "properties": {
        "showWishlist": {
          "title": "Exibir lista de desejos?",
          "type": "boolean",
          "default": true
        },
        "anonymous": {
          "title": "Usuário não logado",
          "type": "object",
          "properties": {
            "title": {
              "title": "Título",
              "type": "string",
              "default": "Bem-vindo!"
            },
            "text": {
              "title": "Texto",
              "type": "string",
              "default": "Identifique-se aqui"
            }
          }
        },
        "logged": {
          "title": "Usuário logado",
          "type": "object",
          "properties": {
            "title": {
              "title": "Título",
              "type": "string",
              "default": "Olá!"
            },
            "text": {
              "title": "Texto",
              "type": "string",
              "default": "Acessar a minha conta"
            }
          }
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}