{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "FooterCustom",
  "$componentTitle": "Footer Custom",
  "title": "Footer Custom",
  "description": "Configurações gerais do rodapé da loja.",
  "type": "object",
  "properties": {
    "logo": {
      "title": "Logo",
      "type": "string",
      "widget": {
        "ui:widget": "media-gallery",
        "restrictMediaTypes": {
          "video": true,
          "image": [
            "png",
            "jpg",
            "jpeg",
            "gif",
            "svg",
            "webp"
          ]
        }
      }
    },
    "menu": {
      "title": "Menu",
      "type": "object",
      "properties": {
        "phoneSanfona": {
          "title": "Usar sanfona no mobile/tablet?",
          "description": "Quando ativo, os grupos do menu ficam fechados por padrão em telas que não são desktop.",
          "type": "boolean",
          "default": true
        },
        "items": {
          "title": "Grupos do menu",
          "type": "array",
          "items": {
            "title": "Grupo",
            "type": "object",
            "properties": {
              "titleGroup": {
                "title": "Título do grupo",
                "type": "string"
              },
              "footerLinks": {
                "title": "Links",
                "type": "array",
                "items": {
                  "title": "Link",
                  "type": "object",
                  "properties": {
                    "text": {
                      "title": "Texto",
                      "type": "string"
                    },
                    "url": {
                      "title": "URL",
                      "description": "Opcional. Caso não seja preenchida, o conteúdo poderá ser exibido como texto.",
                      "type": "string"
                    },
                    "target": {
                      "title": "Abrir em",
                      "type": "string",
                      "default": "_self",
                      "enum": [
                        "_self",
                        "_blank"
                      ],
                      "enumNames": [
                        "Mesma aba",
                        "Nova aba"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "socialMedia": {
      "title": "Redes sociais",
      "type": "object",
      "properties": {
        "showTitle": {
          "title": "Exibir título?",
          "type": "boolean",
          "default": true
        },
        "title": {
          "title": "Título",
          "type": "string",
          "default": "Siga-nos"
        },
        "items": {
          "title": "Redes sociais",
          "type": "array",
          "items": {
            "title": "Rede social",
            "type": "object",
            "properties": {
              "label": {
                "title": "Nome",
                "type": "string"
              },
              "image": {
                "title": "Ícone",
                "type": "string",
                "widget": {
                  "ui:widget": "media-gallery",
                  "restrictMediaTypes": {
                    "video": true,
                    "image": [
                      "png",
                      "jpg",
                      "jpeg",
                      "gif",
                      "svg",
                      "webp"
                    ]
                  }
                }
              },
              "url": {
                "title": "URL",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "payments": {
      "title": "Pagamento",
      "description": "Imagem única com as formas de pagamento aceitas.",
      "type": "object",
      "properties": {
        "label": {
          "title": "Texto alternativo",
          "type": "string",
          "default": "Formas de pagamento"
        },
        "image": {
          "title": "Imagem",
          "type": "string",
          "widget": {
            "ui:widget": "media-gallery",
            "restrictMediaTypes": {
              "video": true,
              "image": [
                "png",
                "jpg",
                "jpeg",
                "gif",
                "svg",
                "webp"
              ]
            }
          }
        },
        "url": {
          "title": "URL",
          "description": "Opcional. Link relacionado à imagem.",
          "type": "string"
        }
      }
    },
    "security": {
      "title": "Segurança",
      "type": "object",
      "properties": {
        "showTitle": {
          "title": "Exibir título?",
          "type": "boolean",
          "default": true
        },
        "title": {
          "title": "Título",
          "type": "string",
          "default": "Segurança"
        },
        "items": {
          "title": "Selos de segurança",
          "type": "array",
          "items": {
            "title": "Selo",
            "type": "object",
            "properties": {
              "label": {
                "title": "Texto alternativo",
                "type": "string"
              },
              "image": {
                "title": "Imagem",
                "type": "string",
                "widget": {
                  "ui:widget": "media-gallery",
                  "restrictMediaTypes": {
                    "video": true,
                    "image": [
                      "png",
                      "jpg",
                      "jpeg",
                      "gif",
                      "svg",
                      "webp"
                    ]
                  }
                }
              },
              "url": {
                "title": "URL",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "powerBy": {
      "title": "Desenvolvido por",
      "type": "object",
      "properties": {
        "showTitle": {
          "title": "Exibir título?",
          "type": "boolean",
          "default": false
        },
        "title": {
          "title": "Título",
          "type": "string"
        },
        "items": {
          "title": "Logos",
          "type": "array",
          "items": {
            "title": "Logo",
            "type": "object",
            "properties": {
              "label": {
                "title": "Texto alternativo",
                "type": "string"
              },
              "image": {
                "title": "Imagem",
                "type": "string",
                "widget": {
                  "ui:widget": "media-gallery",
                  "restrictMediaTypes": {
                    "video": true,
                    "image": [
                      "png",
                      "jpg",
                      "jpeg",
                      "gif",
                      "svg",
                      "webp"
                    ]
                  }
                }
              },
              "url": {
                "title": "URL",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "copyright": {
      "title": "Copyright",
      "description": "Texto exibido na parte inferior do rodapé.",
      "type": "string",
      "widget": {
        "ui:widget": "draftjs-rich-text"
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}