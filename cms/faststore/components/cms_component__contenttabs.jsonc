{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "ContentTabs",
  "$componentTitle": "Abas de conteúdo",
  "title": "Abas de conteúdo",
  "description": "Componente de conteúdo organizado em abas",
  "type": "object",
  "properties": {
    "className": {
      "title": "Classe CSS",
      "type": "string"
    },
    "sectionLabel": {
      "title": "Descrição acessível da seção",
      "type": "string"
    },
    "marginTopSection": {
      "title": "Margem superior",
      "type": "string",
      "description": "Somente números, sem px ou %",
      "default": "40"
    },
    "hasTitle": {
      "title": "Exibir título?",
      "type": "boolean",
      "default": true
    },
    "sizeTitle": {
      "title": "Aparencia do Título",
      "type": "string",
      "enum": [
        "large",
        "medium",
        "small"
      ],
      "enumNames": [
        "grande",
        "medio",
        "pequeno"
      ],
      "default": "medium"
    },
    "textTitle": {
      "title": "Conteúdo título",
      "type": "string",
      "widget": {
        "ui:widget": "draftjs-rich-text"
      }
    },
    "ariaLabel": {
      "title": "Descrição acessível das abas",
      "type": "string",
      "default": "Abas de conteúdo"
    },
    "defaultActiveId": {
      "title": "ID da aba inicial",
      "type": "string",
      "description": "Use o mesmo ID cadastrado na aba"
    },
    "areaSection": {
      "title": "Área da seção",
      "type": "string",
      "enum": [
        "container",
        "full"
      ],
      "enumNames": [
        "Container",
        "Full"
      ],
      "default": "container"
    },
    "maxWidthSection": {
      "title": "Largura máxima",
      "type": "string",
      "description": "Somente números, sem px ou %",
      "default": "1200"
    },
    "desktop": {
      "title": "Estilo das abas (desktop)",
      "type": "object",
      "properties": {
        "titleFontSize": {
          "title": "Tamanho da fonte do título da aba",
          "type": "number",
          "description": "Em pixel"
        },
        "titleMarginTop": {
          "title": "Margem superior do título da aba",
          "type": "number",
          "description": "Espaço entre o conteúdo acima e as abas, em pixel"
        },
        "contentMarginTop": {
          "title": "Margem superior do conteúdo da aba",
          "type": "number",
          "description": "Espaço entre as abas e o conteúdo exibido, em pixel"
        }
      }
    },
    "mobile": {
      "title": "Estilo das abas (mobile)",
      "type": "object",
      "properties": {
        "titleFontSize": {
          "title": "Tamanho da fonte do título da aba",
          "type": "number",
          "description": "Em pixel"
        },
        "titleMarginTop": {
          "title": "Margem superior do título da aba",
          "type": "number",
          "description": "Espaço entre o conteúdo acima e as abas, em pixel"
        },
        "contentMarginTop": {
          "title": "Margem superior do conteúdo da aba",
          "type": "number",
          "description": "Espaço entre as abas e o conteúdo exibido, em pixel"
        }
      }
    },
    "tabs": {
      "type": "array",
      "title": "Abas",
      "items": {
        "type": "object",
        "title": "Aba",
        "properties": {
          "active": {
            "title": "Ativar aba",
            "type": "boolean",
            "default": true
          },
          "id": {
            "title": "Identificador da aba",
            "type": "string",
            "description": "Exemplo: descricao, medidas, cuidados"
          },
          "label": {
            "title": "Título da aba",
            "type": "string"
          },
          "content": {
            "title": "Conteúdo",
            "type": "string",
            "widget": {
              "ui:widget": "draftjs-rich-text"
            }
          },
          "isContentImage": {
            "title": "Conteúdo é somente imagem?",
            "type": "boolean",
            "description": "Se marcado, exibe só a imagem da aba e ignora o texto do campo 'Conteúdo'",
            "default": false
          },
          "desktop": {
            "title": "Imagem (desktop)",
            "type": "object",
            "properties": {
              "srcImage": {
                "title": "Imagem",
                "type": "string",
                "description": "Imagem exibida no conteúdo da aba para desktop",
                "widget": {
                  "ui:widget": "media-gallery",
                  "restrictMediaTypes": {
                    "video": true,
                    "image": [
                      "png",
                      "jpg",
                      "jpeg",
                      "gif",
                      "svg",
                      "webp"
                    ]
                  }
                }
              },
              "width": {
                "title": "Largura da imagem",
                "type": "number",
                "description": "Em pixel. Se deixar em branco (nos dois campos), a imagem preenche 100% do espaço disponível"
              },
              "height": {
                "title": "Altura da imagem",
                "type": "number",
                "description": "Em pixel. Se deixar em branco (nos dois campos), a imagem preenche 100% do espaço disponível"
              }
            }
          },
          "mobile": {
            "title": "Imagem (mobile)",
            "type": "object",
            "properties": {
              "srcImage": {
                "title": "Imagem",
                "type": "string",
                "description": "Imagem exibida no conteúdo da aba para mobile",
                "widget": {
                  "ui:widget": "media-gallery",
                  "restrictMediaTypes": {
                    "video": true,
                    "image": [
                      "png",
                      "jpg",
                      "jpeg",
                      "gif",
                      "svg",
                      "webp"
                    ]
                  }
                }
              },
              "width": {
                "title": "Largura da imagem",
                "type": "number",
                "description": "Em pixel. Se deixar em branco (nos dois campos), a imagem preenche 100% do espaço disponível"
              },
              "height": {
                "title": "Altura da imagem",
                "type": "number",
                "description": "Em pixel. Se deixar em branco (nos dois campos), a imagem preenche 100% do espaço disponível"
              }
            }
          }
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}