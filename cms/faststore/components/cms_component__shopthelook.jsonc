{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "ShopTheLook",
  "$componentTitle": "Shop The Look",
  "title": "Shop The Look",
  "description": "Looks curados exibidos em cards, com modal para adicionar ao carrinho",
  "type": "object",
  "properties": {
    "active": {
      "title": "Ativo",
      "type": "boolean",
      "description": "Ativa o bloco",
      "default": true
    },
    "title": {
      "title": "Título (opcional)",
      "type": "string",
      "description": "Sobrescreve o título retornado pela API"
    },
    "shopButtonLabel": {
      "title": "Texto do botão do card",
      "type": "string",
      "default": "Shop the look"
    },
    "addToCartLabel": {
      "title": "Texto do botão de adicionar ao carrinho",
      "type": "string",
      "default": "Adicionar ao carrinho"
    },
    "seeMoreLabel": {
      "title": "Texto do link \"Ver mais\"",
      "type": "string",
      "default": "Ver mais"
    },
    "marginTopSection": {
      "title": "Margem superior",
      "type": "string",
      "default": "0"
    },
    "sectionLabel": {
      "title": "Descrição acessível da sessão",
      "type": "string"
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}