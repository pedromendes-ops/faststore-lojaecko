{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "CardVideo",
  "$componentTitle": "Card Video",
  "title": "Card Video",
  "description": "Embed de vídeos YouTube, Vimeo ou MP4",
  "type": "object",
  "properties": {
    "areaSection": {
      "title": "Área da sessão",
      "type": "string",
      "enum": [
        "container",
        "full"
      ],
      "enumNames": [
        "Container",
        "Full"
      ],
      "default": "full"
    },
    "maxWidthSection": {
      "title": "Largura máxima",
      "type": "string",
      "description": "Somente números, sem px ou %"
    },
    "marginTopSection": {
      "title": "Margem superior",
      "type": "string",
      "default": "0"
    },
    "customClassSection": {
      "title": "Classe CSS",
      "type": "string"
    },
    "sectionLabel": {
      "title": "Descrição acessível da sessão",
      "type": "string"
    },
    "videoType": {
      "title": "Tipo do vídeo",
      "type": "string",
      "enum": [
        "youtube",
        "vimeo",
        "mp4"
      ],
      "enumNames": [
        "YouTube",
        "Vimeo",
        "MP4"
      ],
      "default": "youtube"
    },
    "videoUrl": {
      "title": "URL do vídeo",
      "type": "string"
    },
    "videoUrlPhone": {
      "title": "URL do vídeo no Mobile",
      "type": "string"
    },
    "videoMp4": {
      "title": "Upload de vídeo",
      "type": "string",
      "widget": {
        "ui:widget": "media-gallery",
        "restrictMediaTypes": {
          "video": true,
          "image": [
            "png",
            "jpg",
            "jpeg",
            "gif",
            "svg",
            "webp"
          ]
        }
      }
    },
    "videoTitle": {
      "title": "Título do vídeo",
      "type": "string",
      "default": "Vídeo"
    },
    "aspectRatio": {
      "title": "Proporção do vídeo",
      "type": "string",
      "enum": [
        "16/9",
        "4/3",
        "1/1",
        "9/16"
      ],
      "enumNames": [
        "16:9",
        "4:3",
        "1:1",
        "9:16"
      ],
      "default": "16/9"
    },
    "fullScreenMobile": {
      "title": "Tela cheia no mobile",
      "description": "Quando ativado, o vídeo ocupa a tela inteira no mobile, ignorando a proporção configurada",
      "type": "boolean",
      "default": false
    },
    "autoplay": {
      "title": "Autoplay",
      "type": "boolean",
      "default": false
    },
    "muted": {
      "title": "Mudo",
      "type": "boolean",
      "default": false
    },
    "loop": {
      "title": "Loop",
      "type": "boolean",
      "default": false
    },
    "controls": {
      "title": "Controles",
      "type": "boolean",
      "default": true
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}