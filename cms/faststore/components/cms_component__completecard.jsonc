{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "CompleteCard",
  "$componentTitle": "Card Complete",
  "title": "Card Complete",
  "description": "Card general",
  "type": "object",
  "properties": {
    "active": {
      "title": "Ativo",
      "type": "boolean",
      "default": true
    },
    "sectionLabel": {
      "title": "Descrição acessível da sessão",
      "type": "string"
    },
    "marginTopSection": {
      "title": "Margem superior da sessão",
      "type": "string",
      "default": "40"
    },
    "marginTopSectionPhone": {
      "title": "Margem superior da sessão no mobile",
      "type": "string",
      "default": "25"
    },
    "hasTitle": {
      "title": "Exibir título?",
      "type": "boolean",
      "default": true
    },
    "sizeTitle": {
      "title": "Aparencia do Título",
      "type": "string",
      "enum": [
        "large",
        "medium",
        "small"
      ],
      "enumNames": [
        "grande",
        "medio",
        "pequeno"
      ],
      "default": "medium"
    },
    "textTitle": {
      "title": "Conteúdo título",
      "type": "string",
      "widget": {
        "ui:widget": "draftjs-rich-text"
      }
    },
    "layoutDesktop": {
      "title": "Layout no desktop",
      "type": "string",
      "enum": [
        "slider",
        "grid"
      ],
      "enumNames": [
        "slider",
        "grid"
      ],
      "default": "grid"
    },
    "columnsDesktop": {
      "title": "Colunas no desktop",
      "type": "string",
      "default": "1",
      "description": "Somente números, sem px ou %"
    },
    "layoutTablet": {
      "title": "Layout no tablet",
      "type": "string",
      "enum": [
        "slider",
        "grid"
      ],
      "enumNames": [
        "slider",
        "grid"
      ],
      "default": "grid"
    },
    "columnsTablet": {
      "title": "Colunas no tablet",
      "type": "string",
      "default": "1",
      "description": "Somente números, sem px ou %"
    },
    "layoutPhone": {
      "title": "Layout no phone",
      "type": "string",
      "enum": [
        "slider",
        "grid"
      ],
      "enumNames": [
        "slider",
        "grid"
      ],
      "default": "grid"
    },
    "columnsPhone": {
      "title": "Colunas no phone",
      "type": "string",
      "default": "1",
      "description": "Somente números, sem px ou %"
    },
    "paddingPx": {
      "title": "Espaçamento entre as colunas",
      "type": "string",
      "default": "10",
      "description": "Somente números, sem px ou %"
    },
    "paddingPxPhone": {
      "title": "Espaçamento entre as colunas no mobile",
      "type": "string",
      "default": "10",
      "description": "Somente números, sem px ou %"
    },
    "customClassSection": {
      "title": "Classe para CSS",
      "type": "string",
      "description": "mediumText, largeText, smallText, strongLink, fontBanner, fontCutPhone"
    },
    "areaSection": {
      "title": "Área da sessão",
      "type": "string",
      "enum": [
        "container",
        "full"
      ],
      "enumNames": [
        "container",
        "full"
      ],
      "default": "full"
    },
    "borderContainer": {
      "title": "Colocar borda no container",
      "type": "string",
      "enum": [
        "none",
        "dashed",
        "dotted"
      ],
      "enumNames": [
        "none",
        "traços",
        "pontos"
      ],
      "default": "none"
    },
    "borderWidth": {
      "title": "Espessura da borda",
      "type": "string",
      "enum": [
        "1px",
        "2px",
        "3px",
        "4px"
      ],
      "enumNames": [
        "1",
        "2",
        "3",
        "4"
      ],
      "default": "1px"
    },
    "paddingBorder": {
      "title": "Espaçamento entre borda e conteúdo",
      "type": "string",
      "description": "Número e unidade de medida"
    },
    "maxWidthSection": {
      "title": "Largura máxima do container sessão",
      "type": "string",
      "description": "Somente números, sem px ou %"
    },
    "cards": {
      "type": "array",
      "title": "Cards Items",
      "description": "Lista dos cards",
      "items": {
        "type": "object",
        "title": "Banner Item",
        "properties": {
          "showBanner": {
            "title": "Exibir imagem",
            "type": "boolean",
            "default": true
          },
          "fileBanner": {
            "type": "string",
            "title": "Image",
            "description": "Imagem do banner",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": [
                  "png",
                  "jpg",
                  "jpeg",
                  "gif",
                  "svg",
                  "webp"
                ]
              }
            }
          },
          "heightBanner": {
            "title": "Altura da imagem",
            "type": "string",
            "description": "Não preencher se quiser a imagem altura auto"
          },
          "widthBanner": {
            "title": "Largura da imagem",
            "type": "string",
            "description": "Não preencher se quiser a imagem largura auto"
          },
          "fileBannerPhone": {
            "type": "string",
            "title": "Image",
            "description": "Imagem do banner mobile",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": [
                  "png",
                  "jpg",
                  "jpeg",
                  "gif",
                  "svg",
                  "webp"
                ]
              }
            }
          },
          "heightBannerPhone": {
            "title": "Altura da imagem mobile",
            "type": "string",
            "description": "Não preencher se quiser a imagem altura auto"
          },
          "widthBannerPhone": {
            "title": "Largura da imagem mobile",
            "type": "string",
            "description": "Não preencher se quiser a imagem largura auto"
          },
          "altBanner": {
            "title": "Texto alternativo da imagem",
            "type": "string"
          },
          "linkBanner": {
            "title": "Link da imagem",
            "type": "string"
          },
          "targetLinkBanner": {
            "title": "Janela do link",
            "type": "string",
            "enum": [
              "_self",
              "_blank"
            ],
            "enumNames": [
              "Mesma",
              "Nova"
            ],
            "default": "_self"
          },
          "hoverZoom": {
            "title": "Aplicar zoom no hover",
            "type": "boolean",
            "default": false
          },
          "showText": {
            "title": "Exibir texto",
            "type": "boolean",
            "default": true
          },
          "styleText": {
            "title": "Estilo do texto",
            "type": "string",
            "enum": [
              "absolute",
              "relative"
            ],
            "enumNames": [
              "Dentro do banner",
              "Fora do banner"
            ],
            "default": "absolute"
          },
          "paddingRightText": {
            "title": "Espaçamento interno direito",
            "type": "string",
            "description": "Somente números, sem px ou %",
            "default": "10"
          },
          "paddingLeftText": {
            "title": "Espaçamento interno esquerdo",
            "type": "string",
            "description": "Somente números, sem px ou %",
            "default": "10"
          },
          "paddingTopText": {
            "title": "Espaçamento interno superior",
            "type": "string",
            "description": "Somente números, sem px ou %",
            "default": "10"
          },
          "paddingBottomText": {
            "title": "Espaçamento interno inferior",
            "type": "string",
            "description": "Somente números, sem px ou %",
            "default": "10"
          },
          "maxWidthText": {
            "title": "Largura máxima da caixa de texto",
            "type": "string",
            "description": "Preencher com número + medida",
            "default": ""
          },
          "backgroundBoxText": {
            "title": "Cor do fundo do box do texto",
            "type": "string",
            "default": "#ffffff",
            "description": "Use (transparent) para deixar sem fundo"
          },
          "orderText": {
            "title": "Ordem dos elementos",
            "type": "string",
            "enum": [
              "left",
              "top",
              "bottom",
              "right"
            ],
            "enumNames": [
              "A esquerda da imagem",
              "Acima da imagem",
              "Abaixo da imagem",
              "A direita da imagem"
            ],
            "default": "left"
          },
          "orderTextPhone": {
            "title": "Comportamento da ordem no mobile",
            "type": "string",
            "enum": [
              "left",
              "top",
              "bottom",
              "right"
            ],
            "enumNames": [
              "A esquerda da imagem",
              "Acima da imagem",
              "Abaixo da imagem",
              "A direita da imagem"
            ],
            "default": "left"
          },
          "positionText": {
            "title": "Posição do texto",
            "type": "string",
            "enum": [
              "left-bottom",
              "right-bottom",
              "center-bottom",
              "top-left",
              "top-right",
              "top-center",
              "center-left",
              "center-right",
              "center-center"
            ],
            "enumNames": [
              "Esquerda embaixo",
              "Direita embaixo",
              "Centro embaixo",
              "Topo esquerdo",
              "Topo direito",
              "Topo centro",
              "Centro esquerdo",
              "Centro direito",
              "Centro centro"
            ],
            "default": "left-bottom"
          },
          "alignText": {
            "title": "Alinhamento do texto",
            "type": "string",
            "enum": [
              "left",
              "right",
              "center",
              "justify"
            ],
            "enumNames": [
              "Esquerda",
              "Direita",
              "Centralizado",
              "Justificado"
            ],
            "default": "left"
          },
          "alignTextPhone": {
            "title": "Centralizar o texto no mobile",
            "type": "boolean",
            "default": false
          },
          "texts": {
            "type": "array",
            "title": "Textos do card",
            "description": "Lista de textos",
            "items": {
              "type": "object",
              "title": "Informações do texto",
              "properties": {
                "magingBottomText": {
                  "title": "Matgin inferior do texto",
                  "type": "string",
                  "default": "0"
                },
                "coloText": {
                  "title": "Cor do texto",
                  "type": "string",
                  "default": "#110b0d"
                },
                "fontSizeText": {
                  "title": "Tamanho da fonte do texto",
                  "type": "string",
                  "default": "16px"
                },
                "fontSizeTextPhone": {
                  "title": "Tamanho da fonte do texto no mobile",
                  "type": "string",
                  "default": "14px"
                },
                "strongText": {
                  "title": "Força do texto",
                  "type": "string",
                  "enum": [
                    "default",
                    "300",
                    "400",
                    "500",
                    "600",
                    "700"
                  ],
                  "enumNames": [
                    "normal",
                    "300",
                    "400",
                    "500",
                    "600",
                    "700"
                  ],
                  "default": "default"
                },
                "rowGapText": {
                  "title": "Espaçamento entre os elementos do texto",
                  "type": "string",
                  "default": "16px",
                  "description": "row-gap css"
                },
                "contentText": {
                  "title": "Conteúdo textual",
                  "type": "string",
                  "widget": {
                    "ui:widget": "draftjs-rich-text"
                  }
                }
              }
            }
          },
          "links": {
            "type": "array",
            "title": "Links junto ao texto",
            "description": "Lista de links veja mais...",
            "items": {
              "type": "object",
              "title": "Informações do link",
              "properties": {
                "linkText": {
                  "title": "Texto do link",
                  "type": "string"
                },
                "urlLinkText": {
                  "title": "Links de veja mais",
                  "type": "string"
                },
                "styleLinkText": {
                  "title": "Estilo do link",
                  "type": "string",
                  "enum": [
                    "button",
                    "link"
                  ],
                  "enumNames": [
                    "Botão",
                    "Link"
                  ],
                  "default": "button"
                },
                "targetLinkText": {
                  "title": "Janela do link",
                  "type": "string",
                  "enum": [
                    "_self",
                    "_blank"
                  ],
                  "enumNames": [
                    "Mesma",
                    "Nova"
                  ],
                  "default": "_self"
                },
                "fontSizeLink": {
                  "title": "Tamanho da fonte do texto no desktop",
                  "type": "string",
                  "default": "13px"
                },
                "fontSizeLinkPhone": {
                  "title": "Tamanho da fonte do texto no mobile",
                  "type": "string",
                  "default": "13px"
                },
                "colorLinkText": {
                  "title": "Cor do texto",
                  "type": "string",
                  "default": "#110b0d"
                },
                "backgroundLinkText": {
                  "title": "Cor do fundo",
                  "type": "string",
                  "default": "#ffffff"
                },
                "borderLinkText": {
                  "title": "Incluir borda no botão",
                  "type": "boolean",
                  "default": true
                },
                "borderWidth": {
                  "title": "Espessura da borda",
                  "type": "string",
                  "enum": [
                    "1px",
                    "2px",
                    "3px"
                  ],
                  "enumNames": [
                    "1",
                    "2",
                    "3"
                  ],
                  "default": "1px"
                },
                "borderColorLinkText": {
                  "title": "Cor da borda",
                  "type": "string",
                  "default": "#110b0d"
                },
                "radiusButton": {
                  "title": "Arredondamento da borda",
                  "type": "string",
                  "default": "0"
                },
                "strongLink": {
                  "title": "Texto do link com destaque",
                  "type": "boolean",
                  "default": false
                }
              }
            }
          },
          "directionLinks": {
            "title": "Direçao dos links",
            "type": "string",
            "enum": [
              "row",
              "columns"
            ],
            "enumNames": [
              "Alinhados na mesma linha",
              "Um embaixo do outro"
            ],
            "default": "row"
          },
          "positionLink": {
            "title": "Posição dos links com relação ao texto",
            "type": "string",
            "enum": [
              "bottom",
              "right"
            ],
            "enumNames": [
              "Embaixo",
              "À Direita"
            ],
            "default": "bottom"
          }
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}