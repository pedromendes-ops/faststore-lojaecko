{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "Faq",
  "$componentTitle": "FAQ",
  "title": "FAQ",
  "description": "Lista de perguntas e respostas em formato de acordeon.",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "title": {
      "title": "Título",
      "type": "string",
      "description": "Título opcional exibido acima da lista de perguntas"
    },
    "items": {
      "title": "Perguntas e respostas",
      "type": "array",
      "items": {
        "title": "Item",
        "type": "object",
        "properties": {
          "question": {
            "title": "Pergunta",
            "type": "string"
          },
          "answer": {
            "title": "Resposta",
            "type": "string",
            "widget": {
              "ui:widget": "draftjs-rich-text"
            }
          }
        },
        "required": [
          "question",
          "answer"
        ]
      },
      "minItems": 1
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}