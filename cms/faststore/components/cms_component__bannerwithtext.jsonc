{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "BannerWithText",
  "$componentTitle": "Banner com Texto",
  "title": "Banner com Texto",
  "description": "Banner com imagem e texto, com posicionamento configurável para desktop e mobile.",
  "type": "object",
  "properties": {
    "classNameContainer": {
      "title": "Classe CSS do contêiner",
      "type": "string",
      "description": "Classe CSS adicional para o contêiner do banner"
    },
    "href": {
      "title": "Link do banner",
      "type": "string",
      "description": "URL para onde o banner deve redirecionar ao ser clicado (opcional)"
    },
    "text": {
      "title": "Texto",
      "type": "string",
      "widget": {
        "ui:widget": "draftjs-rich-text"
      }
    },
    "isFullWidth": {
      "title": "Largura total",
      "type": "boolean",
      "default": true
    },
    "className": {
      "title": "Tamanho do texto",
      "type": "string",
      "description": "Controla o tamanho do texto (parágrafo, títulos e negrito) para desktop e mobile. small: parágrafo 14px, títulos 24px, negrito 14px. medium: parágrafo 16px, títulos 28px, negrito 16px. large: parágrafo 20px, títulos 40px, negrito 20px.",
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "enumNames": [
        "Pequeno",
        "Médio",
        "Grande"
      ],
      "default": "large"
    },
    "desktop": {
      "title": "Configuração desktop",
      "type": "object",
      "properties": {
        "srcImage": {
          "title": "Imagem",
          "type": "string",
          "description": "Imagem do banner para desktop",
          "widget": {
            "ui:widget": "media-gallery",
            "restrictMediaTypes": {
              "video": true,
              "image": [
                "png",
                "jpg",
                "jpeg",
                "gif",
                "svg",
                "webp"
              ]
            }
          }
        },
        "height": {
          "title": "Altura da imagem",
          "type": "number",
          "description": "Altura da imagem em pixel"
        },
        "width": {
          "title": "Largura da imagem",
          "type": "number",
          "description": "Largura da imagem em pixel (usada para otimização, padrão: 1920)"
        },
        "isPositionAbsolute": {
          "title": "Posição absoluta",
          "type": "boolean",
          "default": false
        },
        "centerY": {
          "title": "Centralizar verticalmente",
          "type": "boolean",
          "description": "Centraliza o elemento verticalmente (sobrepõe o valor de 'top')",
          "default": false
        },
        "left": {
          "title": "Distância da esquerda",
          "type": "string",
          "description": "Aceita px ou %, ex: 50px ou 50%"
        },
        "top": {
          "title": "Distância do topo",
          "type": "string",
          "description": "Aceita px ou %, ex: 50px ou 50%"
        },
        "right": {
          "title": "Distância da direita",
          "type": "string",
          "description": "Aceita px ou %, ex: 50px ou 50%"
        },
        "bottom": {
          "title": "Distância de baixo",
          "type": "string",
          "description": "Aceita px ou %, ex: 50px ou 50%"
        },
        "padding": {
          "title": "Espaçamento interno",
          "type": "string",
          "description": "Valor CSS de padding, ex: 10px 20px"
        },
        "maxWidth": {
          "title": "Largura máxima",
          "type": "number",
          "description": "Largura máxima da imagem em pixel"
        }
      }
    },
    "mobile": {
      "title": "Configuração mobile",
      "type": "object",
      "properties": {
        "srcImage": {
          "title": "Imagem",
          "type": "string",
          "description": "Imagem do banner para mobile",
          "widget": {
            "ui:widget": "media-gallery",
            "restrictMediaTypes": {
              "video": true,
              "image": [
                "png",
                "jpg",
                "jpeg",
                "gif",
                "svg",
                "webp"
              ]
            }
          }
        },
        "height": {
          "title": "Altura da imagem",
          "type": "number",
          "description": "Altura da imagem em pixel"
        },
        "isPositionAbsolute": {
          "title": "Posição absoluta",
          "type": "boolean",
          "default": false
        },
        "centerY": {
          "title": "Centralizar verticalmente",
          "type": "boolean",
          "description": "Centraliza o elemento verticalmente (sobrepõe o valor de 'top')",
          "default": false
        },
        "left": {
          "title": "Distância da esquerda",
          "type": "string",
          "description": "Aceita px ou %, ex: 50px ou 50%"
        },
        "top": {
          "title": "Distância do topo",
          "type": "string",
          "description": "Aceita px ou %, ex: 50px ou 50%"
        },
        "right": {
          "title": "Distância da direita",
          "type": "string",
          "description": "Aceita px ou %, ex: 50px ou 50%"
        },
        "bottom": {
          "title": "Distância de baixo",
          "type": "string",
          "description": "Aceita px ou %, ex: 50px ou 50%"
        },
        "flexDirection": {
          "title": "Direção do flex",
          "type": "string",
          "enum": [
            "row",
            "column",
            "row-reverse",
            "column-reverse"
          ],
          "enumNames": [
            "Linha",
            "Coluna",
            "Linha invertida",
            "Coluna invertida"
          ],
          "default": "row"
        },
        "padding": {
          "title": "Espaçamento interno",
          "type": "string",
          "description": "Valor CSS de padding, ex: 10px 20px"
        },
        "maxWidth": {
          "title": "Largura máxima",
          "type": "number",
          "description": "Largura máxima da imagem em pixel"
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}