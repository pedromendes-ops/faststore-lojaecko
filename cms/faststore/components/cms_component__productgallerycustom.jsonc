{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "ProductGalleryCustom",
  "$componentTitle": "Product Gallery Custom",
  "title": "Product Gallery Custom",
  "description": "Configurações da listagem de produtos da PLP e busca.",
  "type": "object",
  "required": [
    "filter"
  ],
  "properties": {
    "config": {
      "title": "Configurações",
      "type": "object",
      "properties": {
        "columnsDesktop": {
          "title": "Produtos por linha",
          "description": "Quantidade inicial de produtos exibidos por linha no desktop.",
          "type": "integer",
          "enum": [
            3,
            4
          ],
          "enumNames": [
            "3 produtos",
            "4 produtos"
          ],
          "default": 4
        },
        "filtersOpen": {
          "title": "Exibir filtros inicialmente",
          "description": "Define se a coluna de filtros inicia aberta no desktop.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "labels": {
      "title": "Textos",
      "type": "object",
      "properties": {
        "filter": {
          "title": "Texto do botão de filtro",
          "type": "string",
          "default": "Filtrar"
        },
        "results": {
          "title": "Texto da quantidade de resultados",
          "type": "string",
          "default": "Resultados"
        }
      }
    },
    "filter": {
      "title": "Filtros",
      "type": "object",
      "required": [
        "title",
        "mobileOnly"
      ],
      "properties": {
        "title": {
          "title": "Título dos filtros",
          "type": "string",
          "default": "Filtros"
        },
        "ordering": {
          "title": "Ordenação dos filtros",
          "description": "Configura a ordem dos grupos de filtros e dos valores exibidos dentro deles.",
          "type": "object",
          "properties": {
            "groups": {
              "title": "Ordenação dos filtros",
              "description": "Define a ordenação geral dos grupos de filtros.",
              "type": "string",
              "enum": [
                "default",
                "asc",
                "desc"
              ],
              "enumNames": [
                "Padrão da VTEX",
                "A - Z",
                "Z - A"
              ],
              "default": "default"
            },
            "values": {
              "title": "Ordenação das opções",
              "description": "Define a ordenação das opções dentro de cada filtro.",
              "type": "string",
              "enum": [
                "default",
                "asc",
                "desc"
              ],
              "enumNames": [
                "Padrão da VTEX",
                "A - Z",
                "Z - A"
              ],
              "default": "default"
            },
            "lastKeys": {
              "title": "Filtros no final",
              "description": "Informe os nomes dos filtros que devem permanecer no final, separados por vírgula. Exemplo: Preço, Disponibilidade.",
              "type": "string"
            },
            "pinned": {
              "title": "Posição dos filtros",
              "description": "Permite definir manualmente a posição de filtros específicos.",
              "type": "array",
              "items": {
                "title": "Filtro",
                "type": "object",
                "required": [
                  "label",
                  "position"
                ],
                "properties": {
                  "label": {
                    "title": "Nome do filtro",
                    "description": "Nome exibido do filtro. Exemplo: Marca, Cor ou Preço.",
                    "type": "string"
                  },
                  "position": {
                    "title": "Posição",
                    "description": "Posição do filtro na listagem. A primeira posição é 1.",
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "hiddenFilter": {
          "title": "Filtros ocultos",
          "description": "Filtros que não devem ser exibidos na listagem.",
          "type": "array",
          "items": {
            "title": "Filtro oculto",
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "title": "Nome do filtro",
                "description": "Nome exibido do filtro que será ocultado. Exemplo: Departamento.",
                "type": "string"
              }
            }
          }
        },
        "mobileOnly": {
          "title": "Filtros no mobile",
          "type": "object",
          "required": [
            "filterButton",
            "clearButtonLabel",
            "applyButtonLabel"
          ],
          "properties": {
            "filterButton": {
              "title": "Botão de filtros",
              "type": "object",
              "required": [
                "label",
                "icon"
              ],
              "properties": {
                "label": {
                  "title": "Texto",
                  "type": "string",
                  "default": "Filtrar"
                },
                "icon": {
                  "title": "Ícone",
                  "type": "object",
                  "required": [
                    "icon",
                    "alt"
                  ],
                  "properties": {
                    "icon": {
                      "title": "Ícone",
                      "type": "string",
                      "enum": [
                        "FadersHorizontal"
                      ],
                      "enumNames": [
                        "Filtros"
                      ],
                      "default": "FadersHorizontal"
                    },
                    "alt": {
                      "title": "Texto alternativo",
                      "type": "string",
                      "default": "Abrir filtros"
                    }
                  }
                }
              }
            },
            "clearButtonLabel": {
              "title": "Texto do botão limpar",
              "type": "string",
              "default": "Limpar filtros"
            },
            "applyButtonLabel": {
              "title": "Texto do botão aplicar",
              "type": "string",
              "default": "Aplicar"
            }
          }
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}