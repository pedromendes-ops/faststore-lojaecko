{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "ProductHighlights",
  "$componentTitle": "Product Highlights",
  "title": "Product Highlights",
  "description": "Destaques de produtos/categorias com imagem, título, descrição e link.",
  "type": "object",
  "required": [
    "title",
    "items"
  ],
  "properties": {
    "show": {
      "title": "Show component",
      "type": "boolean",
      "default": false
    },
    "title": {
      "title": "Título da seção",
      "type": "string",
      "default": "Destaques"
    },
    "items": {
      "title": "Itens",
      "description": "Lista de destaques exibidos",
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "Destaque",
        "type": "object",
        "required": [
          "link",
          "imagemUrl",
          "title"
        ],
        "properties": {
          "imagemUrl": {
            "title": "Imagem",
            "type": "string",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": [
                  "png",
                  "jpg",
                  "jpeg",
                  "gif",
                  "svg",
                  "webp"
                ]
              }
            }
          },
          "link": {
            "title": "URL",
            "type": "string",
            "default": "#"
          },
          "title": {
            "title": "Título",
            "type": "string"
          },
          "description": {
            "title": "Descrição",
            "type": "string"
          }
        }
      }
    },
    "widthDesk": {
      "title": "Largura da imagem (Desktop)",
      "type": "number",
      "default": 300
    },
    "heightDesk": {
      "title": "Altura da imagem (Desktop)",
      "type": "number",
      "default": 300
    },
    "widthMobile": {
      "title": "Largura da imagem (Mobile)",
      "type": "number",
      "default": 150
    },
    "heightMobile": {
      "title": "Altura da imagem (Mobile)",
      "type": "number",
      "default": 150
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}